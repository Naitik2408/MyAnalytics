<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      V1.1 Permission Minimization Policy (docs/12_TECHNICAL_ARCHITECTURE.md):
      - Local Room/DataStore operations work 100% offline.
      - INTERNET and ACCESS_NETWORK_STATE are declared solely for user-initiated
        and user-enabled encrypted Supabase Cloud Backup & Restore.
      - No storage, camera, microphone, location, contacts, or exact-alarm
        permissions are declared.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LifeAnalyticsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeAnalytics">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LifeAnalytics">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.backup.DailyBackupAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
